[Unit]
Description=GitHub-driven Pi agent pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-pipeline
Group=agent-pipeline
SupplementaryGroups=agent-runs
WorkingDirectory=/opt/agent-pipeline
EnvironmentFile=/etc/agent-pipeline.env
Environment=ENV_FILE=/etc/agent-pipeline.env
Environment=HOME=/var/lib/agent-pipeline
ExecStart=/opt/agent-pipeline/run.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027

# Constrained sudo starts Pi/tests as lower-privilege users.
NoNewPrivileges=false
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-pipeline /var/lib/pi-runner /var/lib/agent-pipeline-test
RestrictNamespaces=~cgroup net
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
