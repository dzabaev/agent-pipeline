APP_BASE_URL=https://agents.example.com
SECRET_KEY=replace-with-a-long-random-value
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/etc/agent-pipeline.private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_USER_ID=
DATA_DIR=/var/lib/agent-pipeline
PI_BIN=/usr/local/bin/pi
PI_RUN_AS_USER=agent-pipeline-worker
PI_MODEL=
PI_THINKING=medium
WORKER_CONCURRENCY=1
REQUIRE_CGROUP_ISOLATION=true
JOB_TIMEOUT_SECONDS=1800
VERIFICATION_TIMEOUT_SECONDS=900
